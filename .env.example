# ============================================
# TASK MANAGER APP - CONFIGURAÇÃO
# ============================================

# Copie este arquivo para .env e preencha com suas credenciais
# NÃO COMMIT .env para o GitHub (já está no .gitignore)

# ============================================
# FIREBASE CONFIGURATION
# ============================================

# Obtenha essas informações em:
# 1. Firebase Console: https://console.firebase.google.com
# 2. Clique no seu projeto
# 3. Configurações do projeto (engrenagem) > Seu apps > Copie as credenciais

FIREBASE_API_KEY=sua_api_key_aqui
FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
FIREBASE_DATABASE_URL=https://seu-projeto.firebaseio.com
FIREBASE_PROJECT_ID=seu-projeto-id
FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
FIREBASE_MESSAGING_SENDER_ID=seu_messaging_sender_id
FIREBASE_APP_ID=seu_firebase_app_id

# ============================================
# GOOGLE OAUTH (PARA LOGIN COM GMAIL)
# ============================================

# Para Android:
# 1. Gere SHA-1: cd android && ./gradlew signingReport
# 2. Firebase Console > Authentication > Google > Ativar
# 3. Copie o google-services.json para android/app/

GOOGLE_SIGN_IN_ANDROID_CLIENT_ID=seu_cliente_id_android

# Para iOS:
# 1. Firebase Console > Authentication > Google > Ativar
# 2. Copie o GoogleService-Info.plist para ios/TaskManager/
# 3. Adicione a URL scheme em Xcode

GOOGLE_SIGN_IN_IOS_CLIENT_ID=seu_cliente_id_ios

# ============================================
# APLICAÇÃO
# ============================================

# Ambiente
APP_ENV=development

# Debug mode
DEBUG=true

# Nome do app
APP_NAME=Task Manager

# Versão
APP_VERSION=1.0.0

# ============================================
# SINCRONIZAÇÃO
# ============================================

# Intervalo de sincronização em ms (padrão: 5000)
SYNC_INTERVAL=5000

# Ativar sincronização automática
AUTO_SYNC=true

# ============================================
# NOTIFICAÇÕES (Future)
# ============================================

# Firebase Cloud Messaging
FCM_ANDROID_SENDER_ID=
FCM_SERVER_KEY=

# ============================================
# LOGGING
# ============================================

# Níveis: trace, debug, info, warn, error
LOG_LEVEL=debug

# Ativar logs de sincronização
LOG_SYNC=true

# ============================================
# FEATURES (Beta/Testing)
# ============================================

# Ativar modo escuro
DARK_MODE_ENABLED=false

# Ativar compartilhamento de tarefas
SHARING_ENABLED=false

# Ativar categorias
CATEGORIES_ENABLED=false

# ============================================
# DESENVOLVIMENTO
# ============================================

# Host do Metro bundler
METRO_HOST=localhost

# Porta do Metro bundler
METRO_PORT=8081

# Ativar React DevTools
REACT_NATIVE_DEBUGGER=false

# ============================================
# INSTRUÇÕES DE PREENCHIMENTO
# ============================================

# 1. Acesse https://console.firebase.google.com
# 2. Crie um novo projeto ou selecione existente
# 3. Vá para "Configurações do projeto" (engrenagem)
# 4. Clique em "Seu apps"
# 5. Selecione sua plataforma (Android/iOS)
# 6. Copie os valores e cole acima

# Para Android:
#   - Copie google-services.json para android/app/
#   - Execute: cd android && ./gradlew signingReport

# Para iOS:
#   - Copie GoogleService-Info.plist para ios/TaskManager/
#   - Configure o Bundle ID em Xcode

# ============================================
